+-- 2026-10-04 atrium: which key gives the character, with which modifier ("shift", "altgr" or nil)
+-- and in which layout: "us", "ru", or nil when the key is the same in both (digits, space, tab, return).
+local function key_for(ch)
+	if ch:match("^%l$") then return ch, nil, "us"; end
+	if ch:match("^%u$") then return ch:lower(), "shift", "us"; end
+	if ch:match("^%d$") then return "digit" .. ch, nil, nil; end
+	local k = US_KEYS[ch];
+	if k == "space" or k == "tab" or k == "return" then return k, nil, nil; end
+	if US_KEYS[ch] then return US_KEYS[ch], nil, "us"; end
+	if US_SHIFT_KEYS[ch] then return US_SHIFT_KEYS[ch], "shift", "us"; end
+	if RU_KEYS[ch] then return RU_KEYS[ch], nil, "ru"; end
+	if RU_SHIFT_KEYS[ch] then return RU_SHIFT_KEYS[ch], "shift", "ru"; end
+	local s = RU_SYMBOLS[ch];
+	if s then return s[1], s[2], "ru"; end
+	return nil, nil, nil;
+end
+
+-- 2026-10-04 atrium: one key press with an optional modifier, each as separate events.
+local function press(key, mod)
+	local m = (mod == "shift" and "shift") or (mod == "altgr" and "rightalt") or nil;
+	if m then keyboard.down(m); os.sleep(5); end
+	keyboard.down(key);
+	os.sleep(10);
+	keyboard.up(key);
+	if m then os.sleep(5); keyboard.up(m); end
