+-- 2026-10-04 atrium: Unified Remote cannot see which layout is active, so before a character the
+-- layout it belongs to is selected with the xkb option grp:shift_caps_switch:
+-- Caps Lock = first layout (us), Shift+Caps Lock = last layout (ru).
+local function select_layout(layout)
+	local ru = (layout == "ru");
+	if ru then keyboard.down("shift"); os.sleep(5); end
+	keyboard.down("capslock");
+	os.sleep(10);
+	keyboard.up("capslock");
+	if ru then os.sleep(5); keyboard.up("shift"); end
+	os.sleep(10);
+end
+
+-- state.layout = layout selected during this call (nil = unknown)
+local function type_text(text, state)
+	local i = 1;
+	while i <= #text do
+		local b = text:byte(i);
+		local n = (b >= 0xF0 and 4) or (b >= 0xE0 and 3) or (b >= 0xC0 and 2) or 1;
+		local ch = text:sub(i, i + n - 1);
+		if PLAIN[ch] then
+			type_text(PLAIN[ch], state);
+		else
+			local key, mod, need = key_for(ch);
+			if key == nil then
