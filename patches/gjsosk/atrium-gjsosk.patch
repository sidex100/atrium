 import { Extension, gettext as _ } from 'resource:///org/gnome/shell/extensions/extension.js';
 
+// atrium 2026-11-09: language button in the top bar, right of the settings button. The label is the
+// current input source (EN, RU); a press switches to the next one. The keyboard is rebuilt on every
+// source change (current-source-changed -> refresh), so the label always shows the active layout.
+// A plain function, not a Keyboard method: Keyboard methods are wrapped into async functions by
+// withErrorHandler and would return a Promise.
+function atriumLangButton(kb) {
+    const ism = InputSourceManager.getInputSourceManager();
+    const btn = new St.Button({
+        x_expand: true,
+        y_expand: true,
+        label: (ism.currentSource?.shortName ?? "").toUpperCase()
+    });
+    btn.add_style_class_name("key");
+    const next = () => {
+        const sources = Object.values(ism.inputSources ?? {});
+        const cur = ism.currentSource;
+        if (sources.length < 2 || !cur) return;
+        sources[(cur.index + 1) % sources.length].activate(true);
+    };
+    btn.connect("button-press-event", next);
+    btn.connect("touch-event", () => {
+        if (Clutter.get_current_event().type() == Clutter.EventType.TOUCH_BEGIN) next();
+    });
+    kb.keys.push(btn);
+    return btn;
+}
