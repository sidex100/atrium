# 2026-10-06 atrium: VLC is a spare player. Audio: Russian, then English; subtitles: off by default.
# VLC rewrites this file in full on exit (all defaults as comments) - only the lines below differ from the defaults.
[qt]
# first-run privacy dialog already answered
qt-privacy-ask=0

[core]
# sub-language=none - no automatic subtitle track (VLC source); sub-autodetect-file=0 - otherwise the first
# .srt next to the film is switched on by force
sub-autodetect-file=0
audio-language=ru,en
sub-language=none
metadata-network-access=1
